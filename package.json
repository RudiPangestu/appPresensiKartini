{
  "name": "sma-kartini-presensi",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Presensi Terintegrasi SMA Kartini Batam",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "pnpm --filter @sma-kartini/web dev",
    "dev:mobile": "pnpm --filter @sma-kartini/mobile start",
    "build:web": "pnpm --filter @sma-kartini/web build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:reset": "supabase db reset"
  }
}
