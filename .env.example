# ============================================================
# Sistem Presensi SMA Kartini Batam — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository!

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase FCM (opsional, untuk push notification) ────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Email (Gmail SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                   # Gmail App Password, bukan password biasa

# ── WhatsApp (opsional) ────────────────────────────────────
FONNTE_API_KEY=

# ── Vercel Cron Job ────────────────────────────────────────
CRON_SECRET=                 # Secret untuk validasi cron job endpoint

# ── Webhook ────────────────────────────────────────────────
WEBHOOK_SECRET=              # Secret untuk validasi Supabase webhook

# ── Expo (mobile app) ─────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PROJECT_ID=      # Expo EAS project ID untuk push token
